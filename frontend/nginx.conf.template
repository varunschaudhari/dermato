server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # 127.0.0.11 is Docker's embedded DNS server on the compose network. A bare
    # `proxy_pass http://backend:8000` resolves that hostname ONCE at nginx
    # startup — if the backend container isn't registered on the network yet
    # at that exact moment (a real race on every `docker-compose up`), nginx
    # fails to start at all with "host not found in upstream" and the frontend
    # container exits immediately. Routing proxy_pass through a variable forces
    # nginx to resolve per-request via this resolver instead, so a backend
    # that isn't ready yet is just a slow/failed request, not a dead container.
    resolver 127.0.0.11 valid=10s ipv6=off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Mirrors vite.config.js's dev-server proxy: same two path prefixes go to
    # the backend, everything else is the static SPA build.
    #
    # proxy_pass's automatic location-prefix-replacement (the thing that would
    # normally let a bare `/api/` -> `/api/` mapping be a no-op passthrough)
    # only applies to a STATIC proxy_pass target. The moment the target comes
    # from a variable (required above, to defer DNS resolution), nginx stops
    # doing that rewriting — so we do it explicitly with $request_uri instead,
    # which forwards the exact original path+query untouched either way.
    location /api/ {
        set $backend ${BACKEND_ORIGIN};
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        set $backend ${BACKEND_ORIGIN};
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
    }

    # React Router history mode: unknown paths fall back to index.html instead
    # of a 404, letting the client-side router take over.
    location / {
        try_files $uri /index.html;
    }
}
