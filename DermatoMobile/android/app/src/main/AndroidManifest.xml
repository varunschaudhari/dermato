<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Push notifications: on Android 13+ (API 33+) the app must request this
       at runtime via PermissionsAndroid before it can display a notification;
       see src/services/pushNotifications.ts. Unlike CAMERA below, this one
       genuinely is the library's documented contract, not a footgun. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Requested at runtime via PermissionsAndroid before launchCamera() is
       called (src/screens/AnalyzeScreen.tsx). react-native-image-picker's
       "omit this permission and let the implicit Intent hand off to the
       system camera app" trick (the previous approach here) only works
       reliably on stock/AOSP-like camera apps; several OEM camera apps
       (confirmed by a real-device report: camera did nothing, gallery
       picker worked fine) don't handle a caller that lacks the permission
       gracefully. Declaring it and requesting it explicitly is the
       universally-compatible path. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature
    android:name="android.hardware.camera"
    android:required="false" />

  <application
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:allowBackup="false"
    android:theme="@style/AppTheme"
    android:usesCleartextTraffic="${usesCleartextTraffic}"
    android:supportsRtl="true">
    <activity
      android:name=".MainActivity"
      android:label="@string/app_name"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize"
      android:exported="true"
      android:theme="@style/BootTheme">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
