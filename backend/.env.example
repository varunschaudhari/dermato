# Copy this file to .env and fill in real values for anything beyond local dev.

# MongoDB — assumes a local install running as a service on the default port.
# If the backend runs in Docker instead, use mongodb://host.docker.internal:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=dermato
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10

# Auth — generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30

# Seeded once at startup if the users table is empty — change immediately after first login.
# Login is by phone (see auth.login); ADMIN_EMAIL is kept only for password-reset/notifications.
ADMIN_EMAIL=admin@dermato.local
ADMIN_PASSWORD=changeme123
ADMIN_PHONE=9999999999

# Used to build links inside emails (password reset, etc.)
FRONTEND_URL=http://localhost:3000

# SMTP — leave SMTP_HOST empty to log reset links to the console instead of emailing them
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dermato.local

# Requests per window for login/register/password-reset endpoints, e.g. "5/minute"
LOGIN_RATE_LIMIT=5/minute

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
